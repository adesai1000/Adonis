# Copy to .env for local development. Vercel gets the same names under
# Settings → Environment Variables. Never commit .env itself.

# USDA FoodData Central — free key from https://api.nal.usda.gov/signup
# Powers generic-food search (chicken breast, rice…) and the barcode fallback
# when Open Food Facts has no record. Falls back to the shared DEMO_KEY
# (30 requests/hour) when unset.
USDA_FDC_API_KEY=
