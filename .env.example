# Adonis environment variables — copy to .env for local dev, add to Vercel for prod.
# CLIENT vars are VITE_-prefixed: Vite inlines them into the browser bundle at build
# time — they are PUBLIC. Never put a secret in a VITE_ var.
# SERVER vars are read by the Vercel functions via process.env and never shipped.
# Every feature degrades gracefully when its vars are missing (see SETUP.md).

# ───────────── Supabase — accounts, cloud sync, billing state ─────────────
# CLIENT — Supabase project URL (Supabase → Project Settings → API)
VITE_SUPABASE_URL=
# CLIENT — Supabase anon (publishable) key; safe in the browser, RLS enforces access
VITE_SUPABASE_ANON_KEY=
# SERVER — same value as VITE_SUPABASE_URL
SUPABASE_URL=
# SERVER — same value as VITE_SUPABASE_ANON_KEY (used to verify user JWTs)
SUPABASE_ANON_KEY=
# SERVER — service-role key (Supabase → Project Settings → API); full DB access, server only
SUPABASE_SERVICE_ROLE_KEY=

# ───────────── Stripe — Pro subscriptions ─────────────
# SERVER — secret key (sk_test_… in test mode, sk_live_… at launch)
STRIPE_SECRET_KEY=
# SERVER — signing secret of the /api/stripe-webhook endpoint (whsec_…)
STRIPE_WEBHOOK_SECRET=
# SERVER — price id of Adonis Pro $7.99/month (price_…)
STRIPE_PRICE_MONTHLY=
# SERVER — price id of Adonis Pro $59.99/year (price_…)
STRIPE_PRICE_YEARLY=

# ───────────── Whoop integration (Pro) ─────────────
# SERVER — client id from your developer.whoop.com app
WHOOP_CLIENT_ID=
# SERVER — client secret from your developer.whoop.com app
WHOOP_CLIENT_SECRET=

# ───────────── Google Fit & Fitbit integration (Pro) — via the Google Health API; see SETUP.md §4 ─────────────
# SERVER — OAuth web client id from Google Cloud Console
GOOGLE_FIT_CLIENT_ID=
# SERVER — OAuth web client secret from Google Cloud Console
GOOGLE_FIT_CLIENT_SECRET=

# ───────────── App ─────────────
# SERVER — canonical origin, e.g. https://adonis.example.com (fallback: request origin)
APP_URL=

# ───────────── AI coach ─────────────
# SERVER — DeepSeek API key (sk-…); also read by the Vite dev proxy locally
DEEPSEEK_API=

# ───────────── Legacy sync-code sync (optional; auto-injected when you attach Upstash Redis in Vercel) ─────────────
# SERVER — Upstash Redis REST URL (UPSTASH_REDIS_REST_URL also accepted)
KV_REST_API_URL=
# SERVER — Upstash Redis REST token (UPSTASH_REDIS_REST_TOKEN also accepted)
KV_REST_API_TOKEN=
